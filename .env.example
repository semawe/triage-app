# Triage App — variables d'environnement
#
# Copier ce fichier vers `.env.local` (gitignoré) et renseigner les valeurs.
#   cp .env.example .env.local
#
# Ce fichier est versionné dans un dépôt public : il ne contient QUE des
# placeholders. N'y écrire aucune valeur réelle.
#
# Les quatre premières sections sont obligatoires : sans elles l'application ne
# démarre pas, ou refuse toute connexion. Les suivantes activent des modules
# facultatifs (facturation, e-mail) et peuvent rester vides.


# ─── Base de données (obligatoire) ────────────────────────────────────────────
# PostgreSQL 16+. Lue par `prisma.config.ts` (migrations) et par
# `src/lib/prisma.ts` (adaptateur @prisma/adapter-pg au runtime).
# Sans elle, `prisma migrate` et l'application échouent au premier accès.
DATABASE_URL="postgresql://user:password@localhost:5432/triageapp"


# ─── Session NextAuth (obligatoire) ───────────────────────────────────────────
# Clé de chiffrement des sessions, lue implicitement par next-auth v5.
# Laissée vide ici volontairement : générer une valeur propre à chaque
# environnement, et ne jamais la réutiliser d'un environnement à l'autre.
#   openssl rand -base64 32
AUTH_SECRET=""

# URL canonique de l'application, sans barre oblique finale.
# Lue par next-auth (callback OAuth) ET par le code, pour fabriquer les liens
# d'invitation et les liens invités (src/actions/member.ts, src/actions/guest.ts,
# src/app/[locale]/meetings/[id]/page.tsx). Ces liens partent par e-mail :
# une valeur fausse produit des liens inutilisables.
# Défaut du code si absente : http://localhost:3000
AUTH_URL="http://localhost:3000"

# À passer à `true` uniquement derrière un reverse proxy (Nginx, Traefik) :
# next-auth fait alors confiance aux en-têtes X-Forwarded-*. Inutile en local.
# AUTH_TRUST_HOST=true


# ─── Google OAuth (obligatoire) ───────────────────────────────────────────────
# Seul fournisseur d'authentification (src/lib/auth.ts). Sans ces deux
# variables, l'application démarre mais personne ne peut se connecter.
# Créer un ID client OAuth « Application Web » sur console.cloud.google.com,
# avec pour URI de redirection autorisé :
#   <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID="votre-id-client.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="votre-secret-client"


# ─── Facturation Stripe (facultatif) ──────────────────────────────────────────
# Sans STRIPE_SECRET_KEY, l'application démarre normalement : le client Stripe
# est instancié à la demande (src/lib/stripe.ts) et seules les actions de
# facturation lèvent une erreur. Laisser vide pour une instance non facturée.
STRIPE_SECRET_KEY=""

# Secret de signature de l'endpoint webhook, obtenu à la création de l'endpoint
# dans le tableau de bord Stripe (ou via `stripe listen` en local).
# Obligatoire dès que STRIPE_SECRET_KEY est renseignée : sans lui, la route
# src/app/api/stripe/webhook/route.ts rejette tous les événements.
# Endpoint à déclarer : <NEXT_PUBLIC_APP_URL>/api/stripe/webhook
# Événements : checkout.session.completed, customer.subscription.updated,
#              customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=""

# Base des URL de retour après un paiement Stripe (src/actions/billing.ts).
# Distincte d'AUTH_URL dans le code ; en pratique, même valeur.
# Défaut du code si absente : http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Note : la TVA est calculée par Stripe Tax (`automatic_tax`), à activer dans le
# compte Stripe (adresse d'origine + immatriculation TVA). Aucune variable
# d'environnement à renseigner pour cela.


# ─── E-mails SMTP (facultatif) ────────────────────────────────────────────────
# Invitations et comptes-rendus de réunion (src/lib/email.ts), via le relais
# SMTP de Brevo (smtp-relay.brevo.com:587, en dur dans le code).
# BREVO_SMTP_PASSWORD sert d'interrupteur : vide, l'envoi est désactivé
# proprement et l'application signale « BREVO_SMTP_PASSWORD non configurée »
# au lieu de planter. Le reste du produit fonctionne sans.
BREVO_SMTP_USER=""
BREVO_SMTP_PASSWORD=""

# Adresse expéditrice. Défaut du code si absente : noreply@triapp.fr
EMAIL_FROM="noreply@example.org"


# ─── Build (facultatif) ───────────────────────────────────────────────────────
# Répertoire de build Next (next.config.ts). Défaut : .next
# Sert au déploiement bleu/vert, où chaque couleur construit dans le sien.
# NEXT_DIST_DIR=".next"

# Saute le type-check intégré à `next build` (next.config.ts).
# Réservé aux machines à faible RAM où le type-check est tué par l'OOM, et
# seulement après un `npm run typecheck` passé en amont.
# SKIP_BUILD_CHECKS=1
