# Miroir versionné de /etc/systemd/system/triage-app@.service sur le VPS.
#
# Template à deux instances, nommées par leur port : triage-app@3002 et
# triage-app@3003. Ce sont les deux couleurs du déploiement bleu/vert — une
# seule sert le trafic à un instant donné, celle vers laquelle pointe
# /etc/nginx/conf.d/triapp-upstream.conf.
#
# Chaque couleur sert son propre répertoire de build (.next-3002 / .next-3003) :
# la compilation de la nouvelle version ne touche jamais aux fichiers servis par
# l'ancienne. C'était l'autre moitié du problème corrigé le 15/08/2026 — le
# `mv .next .next.old` de l'ancien script retirait les chunks sous les pieds du
# processus encore vivant.
#
# Remplace triage-app.service (instance unique, port 3002 en dur), désactivé le
# 15/08/2026. Le drop-in de durcissement A5 est repris à l'identique dans
# /etc/systemd/system/triage-app@.service.d/durcissement-a5.conf.
[Unit]
Description=triage-app (port %i)
After=network.target postgresql.service

[Service]
Type=simple
User=triageapp
WorkingDirectory=/home/debian/triage-app
Environment=HOME=/home/triageapp
Environment=NODE_ENV=production
Environment=NEXT_DIST_DIR=.next-%i
ExecStart=/usr/bin/node /home/debian/triage-app/node_modules/.bin/next start -p %i -H 127.0.0.1
Restart=on-failure
RestartSec=3

# `next start` n'installe pas de gestionnaire SIGTERM et meurt du signal : il sort
# en 143 (128+15). Sans cette ligne, systemd compte chaque arrêt de couleur comme
# un échec et laisse une unité `failed` derrière chaque déploiement — bruit
# permanent dans `systemctl --failed`, sur une box qui est surveillée.
SuccessExitStatus=143

# Le retrait de l'ancienne couleur n'attend pas la fin des connexions : les flux
# SSE ne se terminent jamais d'eux-mêmes. Le trafic est déjà passé sur la
# nouvelle instance quand ce délai court, et les clients EventSource s'y
# reconnectent seuls.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
