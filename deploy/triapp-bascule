#!/bin/bash
#
# triapp-bascule — voie étroite et auditée par laquelle le déploiement obtient
# les trois gestes privilégiés de la bascule bleu/vert, sans que le compte
# deploybot reçoive le droit d'écrire dans /etc/nginx ni de piloter systemd.
#
# Miroir versionné de /usr/local/sbin/triapp-bascule (root:root, 0755).
#
# Contexte : le durcissement du 09/08/2026 a réduit deploybot à « devenir les
# trois comptes applicatifs, et redémarrer les trois services ». La bascule
# gracieuse demande davantage (démarrer une seconde instance, réécrire la cible
# nginx, recharger nginx). Plutôt que d'élargir deploybot, ces gestes sont
# figés ici et ouverts par six entrées sudo littérales, sans joker :
#
#   deploybot ALL=(root) NOPASSWD: /usr/local/sbin/triapp-bascule demarrer 3002, \
#                                  /usr/local/sbin/triapp-bascule demarrer 3003, \
#                                  /usr/local/sbin/triapp-bascule activer 3002, \
#                                  /usr/local/sbin/triapp-bascule activer 3003, \
#                                  /usr/local/sbin/triapp-bascule arreter 3002, \
#                                  /usr/local/sbin/triapp-bascule arreter 3003
#
# Le port est de toute façon revalidé ci-dessous : ce script ne construit aucune
# commande à partir d'une chaîne non contrôlée.
set -euo pipefail

UPSTREAM=/etc/nginx/conf.d/triapp-upstream.conf

usage() {
  echo "usage: triapp-bascule {demarrer|activer|arreter} {3002|3003}" >&2
  exit 2
}

[ $# -eq 2 ] || usage
VERBE=$1
PORT=$2

case "$PORT" in
  3002) AUTRE=3003 ;;
  3003) AUTRE=3002 ;;
  *) echo "triapp-bascule : port non autorisé ($PORT)" >&2; exit 2 ;;
esac

case "$VERBE" in
  demarrer)
    systemctl start "triage-app@$PORT"
    ;;

  arreter)
    systemctl stop "triage-app@$PORT"
    ;;

  activer)
    # La cible doit écouter avant qu'on lui envoie le trafic. Le script de
    # déploiement l'a déjà vérifiée par sa sonde HTTP ; on revérifie ici, parce
    # que ce script est le dernier rempart avant la production.
    if ! curl -fsS -m 3 -o /dev/null "http://127.0.0.1:$PORT/api/health"; then
      echo "triapp-bascule : $PORT ne répond pas sur /api/health — bascule refusée" >&2
      exit 1
    fi

    SAUVEGARDE=$(mktemp)
    [ -f "$UPSTREAM" ] && cp -a "$UPSTREAM" "$SAUVEGARDE"

    cat > "$UPSTREAM" <<EOF
# Cible active de triapp.fr — réécrit à chaque déploiement par
# /usr/local/sbin/triapp-bascule. Ne pas éditer à la main.
upstream triapp_app {
    server 127.0.0.1:$PORT;
}
EOF

    # Une conf invalide laissée sur disque ferait échouer le prochain reload de
    # nginx, y compris celui de certbot au renouvellement du certificat.
    if ! nginx -t; then
      echo "triapp-bascule : nginx -t a échoué, restauration de la cible précédente" >&2
      cp -a "$SAUVEGARDE" "$UPSTREAM"
      rm -f "$SAUVEGARDE"
      exit 1
    fi
    rm -f "$SAUVEGARDE"

    # reload, pas restart : les workers en place terminent leurs requêtes.
    systemctl reload nginx

    # Au prochain démarrage de la box, c'est la couleur en service qui remonte.
    systemctl enable "triage-app@$PORT" >/dev/null 2>&1 || true
    systemctl disable "triage-app@$AUTRE" >/dev/null 2>&1 || true
    ;;

  *)
    usage
    ;;
esac
