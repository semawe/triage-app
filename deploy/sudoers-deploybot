# Miroir versionné de /etc/sudoers.d/deploybot sur le VPS (root:root, 0440).
# Ce fichier concerne les trois applications de la box ; il est repris ici parce que la
# bascule bleu/vert de triage-app en dépend. Source de reconstruction complète :
# ~/dev/ovh/infra-monitoring/scripts/vps-rebuild/reference-145.239.55.58/
#
# Droits du compte de déploiement. Repris de ce que les scripts deploy-*.sh exécutent
# réellement : devenir le compte applicatif, et redémarrer son service. Rien de plus.
# Volontairement PAS de (ALL) ALL, PAS de sudo vers root hors des redémarrages.
deploybot ALL=(elearning, triageapp, ofqualiopi) NOPASSWD: ALL
deploybot ALL=(root) NOPASSWD: /usr/bin/systemctl restart plateforme-elearning, /usr/bin/systemctl restart of-qualiopi

# Bascule bleu/vert de triage-app (15/08/2026). Six commandes littérales, sans joker :
# le compte de déploiement obtient les trois gestes privilégiés de la bascule sans recevoir
# le droit d'écrire dans /etc/nginx ni de piloter systemd librement. Le script appelé est
# root:root 0755 — deploybot ne peut pas le modifier. Cf. deploy/triapp-bascule.
# `systemctl restart triage-app` a disparu avec le service mono-instance qu'il visait.
deploybot ALL=(root) NOPASSWD: /usr/local/sbin/triapp-bascule demarrer 3002, /usr/local/sbin/triapp-bascule demarrer 3003, /usr/local/sbin/triapp-bascule activer 3002, /usr/local/sbin/triapp-bascule activer 3003, /usr/local/sbin/triapp-bascule arreter 3002, /usr/local/sbin/triapp-bascule arreter 3003
